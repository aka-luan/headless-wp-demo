# Copy to .env. Values below are local-development defaults only.
COMPOSE_PROFILES=dev
BRAND_NAME=Tagline

# Hosts (production: tagline.<your-domain> and cms.tagline.<your-domain>)
SITE_HOST=tagline.localhost
CMS_HOST=cms.tagline.localhost
SITE_URL=http://tagline.localhost
CMS_URL=http://cms.tagline.localhost
WP_ENVIRONMENT_TYPE=local

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-local
DB_ROOT_PASSWORD=root-local

# WP admin created by the seed step (local only)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin-local-only
WP_ADMIN_EMAIL=admin@tagline.localhost

# Next.js <-> WordPress
WP_GRAPHQL_URL=http://cms.tagline.localhost/graphql
WP_APP_USER=admin
WP_APP_PASSWORD=
REVALIDATE_SECRET=local-revalidate-secret
PREVIEW_SECRET=local-preview-secret

# Mail (Mailpit locally)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
CONTACT_TO=hello@tagline.localhost
