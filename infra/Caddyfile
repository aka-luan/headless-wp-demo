# Local dev serves plain HTTP on *.localhost. In production, drop the
# "http://" prefixes and the global options so Caddy issues certificates.
{
	auto_https off
	admin off
}

http://{$CMS_HOST} {
	root * /var/www/html
	encode zstd gzip
	php_fastcgi wordpress:9000
	file_server
}

http://{$SITE_HOST} {
	reverse_proxy web:3000
}
