# Caddy serves plain HTTP in every environment. Locally it is the entry point on port 80;
# in production host nginx terminates TLS and proxies here (infra/nginx/tagline.conf).
{
	auto_https off
	admin off
	servers {
		# Keep nginx's X-Forwarded-For/-Proto, so WordPress sees HTTPS and Next sees the client IP.
		trusted_proxies static private_ranges
	}
}

http://{$CMS_HOST} {
	root * /var/www/html
	encode zstd gzip
	php_fastcgi wordpress:9000
	file_server
}

http://{$SITE_HOST} {
	reverse_proxy web:3000
}
